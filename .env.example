# Database
# Local dev: point this at a local Postgres instance, e.g.
#   DATABASE_URL="postgresql://postgres:postgres@localhost:5432/fleetlink"
# Production: use your hosted Postgres connection string (Vercel Postgres,
# Neon, Supabase, Railway, ...).
DATABASE_URL="postgresql://user:password@localhost:5432/fleetlink"

# Auth
AUTH_SECRET="change-me-to-a-long-random-string"

# Google Sign-In (optional). Without these, the "Continuer avec Google"
# button shows a clear error instead of crashing. See README for how to
# create OAuth credentials in Google Cloud Console.
GOOGLE_CLIENT_ID=""
GOOGLE_CLIENT_SECRET=""

# Public base URL, used to build the driver portal / customer feedback links
# sent over WhatsApp. Set this to your real domain in production.
APP_URL="http://localhost:3000"

# Vercel Blob store token, used to store proof-of-delivery photos. Required
# in production (serverless filesystems are read-only/ephemeral). Leave empty
# in local dev to fall back to writing photos under public/uploads/pod.
BLOB_READ_WRITE_TOKEN=""

# WhatsApp Cloud API (Meta) - optional at the platform level.
# Each company can also configure its own credentials from Settings in the app.
# If nothing is configured, WhatsApp sends are simulated (logged, not actually sent)
# so the app is fully usable without a Meta Business account.
WHATSAPP_API_VERSION="v20.0"
WHATSAPP_DEFAULT_PHONE_NUMBER_ID=""
WHATSAPP_DEFAULT_ACCESS_TOKEN=""

# Traccar bridge (optional) - only needed if you're connecting cheap
# hardware GPS trackers (GT06/TK103/Teltonika) to trailers/tractors via a
# self-hosted Traccar server. Run with `npm run gps:bridge`. See README,
# section "Connecter un traceur GPS materiel bon marche".
TRACCAR_URL=""
TRACCAR_EMAIL=""
TRACCAR_PASSWORD=""
TRACCAR_DEVICE_MAP=""
