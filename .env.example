# Database
DATABASE_URL="file:./dev.db"

# Auth
AUTH_SECRET="change-me-to-a-long-random-string"

# Public base URL, used to build the driver portal / customer feedback links
# sent over WhatsApp. Set this to your real domain in production.
APP_URL="http://localhost:3000"

# WhatsApp Cloud API (Meta) - optional at the platform level.
# Each company can also configure its own credentials from Settings in the app.
# If nothing is configured, WhatsApp sends are simulated (logged, not actually sent)
# so the app is fully usable without a Meta Business account.
WHATSAPP_API_VERSION="v20.0"
WHATSAPP_DEFAULT_PHONE_NUMBER_ID=""
WHATSAPP_DEFAULT_ACCESS_TOKEN=""
