generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// Status/category/type fields below are plain strings rather than native
// Prisma enums, so they stay valid across providers. The allowed values are
// enforced at the application layer (see src/lib/enums.ts and src/lib/validation.ts).

model Company {
  id                       String   @id @default(cuid())
  name                     String
  whatsappPhoneNumberId    String?
  whatsappAccessToken      String?
  whatsappTestRecipient    String?
  depotAddress             String?
  depotLat                 Float?
  depotLng                 Float?
  createdAt                DateTime @default(now())
  updatedAt                DateTime @updatedAt

  users             User[]
  drivers           Driver[]
  tractors          Tractor[]
  trailers          Trailer[]
  trips             Trip[]
  orders            Order[]
  driverPositions   DriverPosition[]
  vehiclePositions  VehiclePosition[]
  dashcamVideos     DashcamVideo[]
  maintenanceRecords MaintenanceRecord[]
  recommendations   Recommendation[]
  whatsappMessages  WhatsAppMessage[]
}

model User {
  id           String   @id @default(cuid())
  companyId    String
  company      Company  @relation(fields: [companyId], references: [id], onDelete: Cascade)
  email        String   @unique
  passwordHash String
  googleId     String?  @unique
  name         String
  role         String   @default("ADMIN")
  createdAt    DateTime @default(now())

  @@index([companyId])
}

model Driver {
  id            String       @id @default(cuid())
  companyId     String
  company       Company      @relation(fields: [companyId], references: [id], onDelete: Cascade)
  firstName     String
  lastName      String
  phone         String
  licenseNumber String
  licenseExpiry DateTime
  status        String       @default("ACTIVE")
  hireDate      DateTime?
  notes         String?
  skills        String?
  costPerKm     Float?
  accessToken   String       @unique @default(cuid())
  createdAt     DateTime     @default(now())
  updatedAt     DateTime     @updatedAt

  trips           Trip[]
  driverPositions DriverPosition[]
  dashcamVideos   DashcamVideo[]

  @@index([companyId])
}

model Tractor {
  id                       String        @id @default(cuid())
  companyId                String
  company                  Company       @relation(fields: [companyId], references: [id], onDelete: Cascade)
  plateNumber              String
  brand                    String
  model                    String
  year                     Int?
  mileage                  Int           @default(0)
  status                   String        @default("AVAILABLE")
  lastMaintenanceDate      DateTime?
  lastMaintenanceMileage   Int?
  nextMaintenanceMileage   Int?
  insuranceExpiry          DateTime?
  technicalControlExpiry  DateTime?
  costPerKm                Float?
  hazmatCertified          Boolean       @default(false)
  notes                    String?
  createdAt                DateTime      @default(now())
  updatedAt                DateTime      @updatedAt

  fuelLevelPercent         Int?
  adBlueLevelPercent       Int?
  gpsDeviceToken           String?       @unique @default(cuid())

  trips              Trip[]
  maintenanceRecords  MaintenanceRecord[]
  vehiclePositions   VehiclePosition[]

  @@index([companyId])
}

model Trailer {
  id                  String        @id @default(cuid())
  companyId           String
  company             Company       @relation(fields: [companyId], references: [id], onDelete: Cascade)
  plateNumber         String
  type                String        @default("CURTAIN")
  capacityTons        Float?
  status              String        @default("AVAILABLE")
  lastInspectionDate  DateTime?
  nextInspectionDate  DateTime?
  insuranceExpiry     DateTime?
  notes               String?
  gpsDeviceToken      String?       @unique @default(cuid())
  createdAt           DateTime      @default(now())
  updatedAt           DateTime      @updatedAt

  trips              Trip[]
  maintenanceRecords  MaintenanceRecord[]
  vehiclePositions   VehiclePosition[]

  @@index([companyId])
}

model Trip {
  id                  String     @id @default(cuid())
  companyId           String
  company              Company   @relation(fields: [companyId], references: [id], onDelete: Cascade)
  tractorId            String
  tractor              Tractor   @relation(fields: [tractorId], references: [id])
  trailerId            String?
  trailer              Trailer?  @relation(fields: [trailerId], references: [id])
  driverId             String
  driver               Driver    @relation(fields: [driverId], references: [id])
  origin               String
  destination           String
  departureAt           DateTime
  estimatedArrivalAt    DateTime?
  actualArrivalAt       DateTime?
  status                String    @default("PLANNED")
  cargoDescription      String?
  distanceKm            Float?
  estimatedDurationMin  Int?
  routeGeometry         String?
  avoidNotes            String?
  driverNotifiedAt      DateTime?
  createdAt             DateTime   @default(now())
  updatedAt             DateTime   @updatedAt

  orders        Order[]
  dashcamVideos DashcamVideo[]

  @@index([companyId])
  @@index([tractorId])
  @@index([trailerId])
  @@index([driverId])
}

model Order {
  id                  String    @id @default(cuid())
  companyId           String
  company             Company   @relation(fields: [companyId], references: [id], onDelete: Cascade)
  reference           String
  customerName        String
  customerPhone       String?
  pickupAddress       String
  pickupLat           Float?
  pickupLng           Float?
  deliveryAddress     String
  deliveryLat         Float?
  deliveryLng         Float?
  priority            String    @default("MEDIUM")
  requiredSkills       String?
  serviceDurationMin  Int       @default(15)
  timeWindowStart     DateTime?
  timeWindowEnd       DateTime?
  weightKg            Float?
  hazmat              Boolean   @default(false)
  status              String    @default("PENDING")
  tripId              String?
  trip                Trip?     @relation(fields: [tripId], references: [id])
  sequence            Int?
  podSignature        String?
  podPhotoPath        String?
  podNotes            String?
  podBarcode          String?
  deliveredAt         DateTime?
  customerNotifiedAt  DateTime?
  feedbackToken       String    @unique @default(cuid())
  customerRating      Int?
  customerFeedback    String?
  feedbackAt          DateTime?
  createdAt           DateTime  @default(now())
  updatedAt           DateTime  @updatedAt

  @@index([companyId])
  @@index([tripId])
}

model DriverPosition {
  id         String   @id @default(cuid())
  companyId  String
  company    Company  @relation(fields: [companyId], references: [id], onDelete: Cascade)
  driverId   String
  driver     Driver   @relation(fields: [driverId], references: [id], onDelete: Cascade)
  tripId     String?
  lat        Float
  lng        Float
  recordedAt DateTime @default(now())

  @@index([companyId])
  @@index([driverId])
}

// Positions reported by a physical GPS tracker installed on the vehicle
// itself (authenticated via Tractor/Trailer.gpsDeviceToken), independent of
// whether a driver's phone is reporting via DriverPosition. See
// /api/gps/[token]/position and the README for the device webhook format.
model VehiclePosition {
  id         String   @id @default(cuid())
  companyId  String
  company    Company  @relation(fields: [companyId], references: [id], onDelete: Cascade)
  tractorId  String?
  tractor    Tractor? @relation(fields: [tractorId], references: [id], onDelete: Cascade)
  trailerId  String?
  trailer    Trailer? @relation(fields: [trailerId], references: [id], onDelete: Cascade)
  lat        Float
  lng        Float
  speedKmh   Float?
  heading    Float?
  recordedAt DateTime @default(now())

  @@index([companyId])
  @@index([tractorId])
  @@index([trailerId])
}

// Dashcam video segments recorded from the driver's phone camera during a
// trip (driver portal), uploaded to object storage. A daily cron
// (/api/cron/dashcam-cleanup) deletes segments older than 3 days that were
// never marked downloaded, so storage doesn't grow unbounded.
model DashcamVideo {
  id           String    @id @default(cuid())
  companyId    String
  company      Company   @relation(fields: [companyId], references: [id], onDelete: Cascade)
  tripId       String?
  trip         Trip?     @relation(fields: [tripId], references: [id], onDelete: SetNull)
  driverId     String?
  driver       Driver?   @relation(fields: [driverId], references: [id], onDelete: SetNull)
  videoUrl     String
  segmentIndex Int       @default(0)
  durationSec  Int?
  recordedAt   DateTime  @default(now())
  downloaded   Boolean   @default(false)
  downloadedAt DateTime?

  @@index([companyId])
  @@index([tripId])
  @@index([recordedAt])
}

model MaintenanceRecord {
  id            String          @id @default(cuid())
  companyId     String
  company       Company         @relation(fields: [companyId], references: [id], onDelete: Cascade)
  tractorId     String?
  tractor       Tractor?        @relation(fields: [tractorId], references: [id])
  trailerId     String?
  trailer       Trailer?        @relation(fields: [trailerId], references: [id])
  type          String          @default("OTHER")
  performedAt   DateTime
  mileage       Int?
  cost          Float?
  notes         String?
  nextDueAt     DateTime?
  nextDueMileage Int?
  createdAt     DateTime        @default(now())

  @@index([companyId])
  @@index([tractorId])
  @@index([trailerId])
}

model Recommendation {
  id          String    @id @default(cuid())
  companyId   String
  company     Company   @relation(fields: [companyId], references: [id], onDelete: Cascade)
  entityType  String
  entityId    String
  entityLabel String
  severity    String    @default("INFO")
  category    String
  title       String
  message     String
  dueAt       DateTime?
  resolved    Boolean   @default(false)
  resolvedAt  DateTime?
  createdAt   DateTime  @default(now())

  @@index([companyId])
  @@unique([companyId, entityType, entityId, category, title])
}

model WhatsAppMessage {
  id                 String    @id @default(cuid())
  companyId          String
  company             Company  @relation(fields: [companyId], references: [id], onDelete: Cascade)
  driverId            String?
  toPhone             String
  type                String    @default("CUSTOM")
  body                String
  status              String    @default("PENDING")
  providerMessageId   String?
  errorMessage        String?
  createdAt           DateTime  @default(now())

  @@index([companyId])
  @@index([driverId])
}
